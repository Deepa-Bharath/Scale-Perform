{
  "name": "scale-perform",
  "version": "1.0.0",
  "description": "TypeScript API for scalability and performance experiments with a local-first development workflow.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "migrate:up": "npm run build && migrate-mongo up",
    "migrate:down": "npm run build && migrate-mongo down",
    "migrate:status": "npm run build && migrate-mongo status",
    "start": "node dist/index.js",
    "dev": "concurrently \"npm:watch\" \"npm:serve:dev\"",
    "serve:dev": "nodemon",
    "watch": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.3",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "redis": "^5.8.1",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "jest": "^30.0.5",
    "migrate-mongo": "^14.0.7",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2"
  }
}
